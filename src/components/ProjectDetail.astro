---
import { projectsStaticData } from "@data/projectsData";
import { useTranslations } from "@i18n/utils";
import { Icon } from "astro-icon/components";

export interface Props {
  id: string;
}

const { id } = Astro.props;
const t = useTranslations(Astro.currentLocale as "en" | "es");

const projectBase = projectsStaticData[id as keyof typeof projectsStaticData];

const project = {
  ...projectBase,
  title: t(projectBase.title as any),
  subtitle: t(projectBase.subtitle as any),
  description: t(projectBase.description as any),
  longDescription: t(projectBase.longDescription as any),
  role: t(projectBase.role as any),
  features: projectBase.features.map((feature) => t(feature as any)),
  challenges: projectBase.challenges.map((challenge) => t(challenge as any)),
  solutions: projectBase.solutions.map((solution) => t(solution as any)),
  timeline: t(projectBase.timeline as any),
};

const getRandomColor = (index: number) => {
  const colors = [
    "bg-primary/20 text-primary border-primary/30",
    "bg-secondary/20 text-secondary border-secondary/30",
    "bg-purple-500/20 text-purple-400 border-purple-500/30",
    "bg-blue-500/20 text-blue-400 border-blue-500/30",
    "bg-green-500/20 text-green-400 border-green-500/30",
    "bg-yellow-500/20 text-yellow-400 border-yellow-500/30",
    "bg-red-500/20 text-red-400 border-red-500/30",
    "bg-pink-500/20 text-pink-400 border-pink-500/30",
  ];
  return colors[index % colors.length];
};
---

<div class="min-h-screen bg-background text-on-background">
  <div
    class="bg-surface border-b border-outline/20 sticky top-0 z-40 backdrop-blur-sm"
  >
    <div class="container mx-auto px-8 py-4">
      <nav class="flex items-center gap-2 text-sm text-outline">
        <a href="/" class="hover:text-primary transition-colors"
          >{t("project.nav.home")}</a
        >
        <span>/</span>
        <span class="text-primary">{project.title}</span>
      </nav>
    </div>
  </div>

  <div class="container mx-auto px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-8">
        <header class="space-y-4">
          <h1 class="text-5xl font-bold gradient-bg">
            {project.title}
          </h1>
          <p class="text-xl text-outline">{project.subtitle}</p>
          <p class="text-lg leading-relaxed">{project.description}</p>
        </header>

        <section
          id="overview"
          class="bg-surface-container-high rounded-4xl p-8 border border-outline/20"
        >
          <h2
            class="text-2xl font-bold text-primary mb-6 flex items-center gap-2"
          >
            <span class="text-2xl">
              <Icon name="notebook" class="w-6 h-6" />
            </span>
            {t("project.section.overview")}
          </h2>
          <div class="prose prose-invert max-w-none">
            <p class="text-lg leading-relaxed">{project.longDescription}</p>
          </div>
        </section>

        <section
          id="features"
          class="bg-surface-container-low rounded-4xl p-8 border border-outline/10"
        >
          <h2
            class="text-2xl font-bold text-primary mb-6 flex items-center gap-2"
          >
            <span class="text-2xl">
              <Icon name="sparkles" class="w-6 h-6" />
            </span>
            {t("project.section.features")}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
              project.features.map((feature, index) => (
                <div class="flex items-start gap-3 p-4 bg-surface-container-high rounded-2xl transition-all duration-300 hover:bg-surface-container-highest ">
                  <p class="text-on-surface">{feature}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section
          id="challenges"
          class="bg-surface rounded-4xl p-8 border border-outline/20"
        >
          <h2
            class="text-2xl font-bold text-primary mb-6 flex items-center gap-2"
          >
            <span class="text-2xl">
              <Icon name="trending-up-down" class="w-6 h-6" />
            </span>
            {t("project.section.challenges")}
          </h2>
          <div class="space-y-6">
            {
              project.challenges.map((challenge, index) => (
                <div class="border-l-4 border-primary pl-6">
                  <h3 class="text-lg font-semibold text-primary mb-2">
                    {t("project.section.challenge")} {index + 1}
                  </h3>
                  <p class="text-outline mb-3">{challenge}</p>
                  {project.solutions[index] && (
                    <>
                      <h4 class="text-md font-medium text-secondary mb-2">
                        {t("project.section.solution")}
                      </h4>
                      <p class="text-on-surface">{project.solutions[index]}</p>
                    </>
                  )}
                </div>
              ))
            }
          </div>
        </section>

        <section
          id="technologies"
          class="bg-surface-container-low rounded-4xl p-8 border border-outline/20"
        >
          <h2
            class="text-2xl font-bold text-primary mb-6 flex items-center gap-2"
          >
            <span class="text-2xl"><Icon name="pickaxe" class="w-6 h-6" /></span
            >
            {t("project.section.technologies")}
          </h2>
          <div class="flex flex-wrap gap-3">
            {
              project.technologies.map((tech, index) => (
                <span
                  class={`px-4 py-2 rounded-full text-sm font-medium border transition-all hover:scale-105 ${getRandomColor(index)}`}
                >
                  {tech}
                </span>
              ))
            }
          </div>
        </section>

        {
          project.images.length > 0 && (
            <section
              id="gallery"
              class="bg-surface rounded-4xl p-8 border border-outline/20"
            >
              <h2 class="text-2xl font-bold text-primary mb-6 flex items-center gap-2">
                <span class="text-2xl">
                  <Icon name="images" class="w-6 h-6" />
                </span>
                {t("project.section.gallery")}
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {project.images.map((image, index) => (
                  <div class="aspect-video bg-surface-variant rounded-3xl overflow-hidden group cursor-pointer">
                    <img
                      src={image}
                      alt={`${project.title} - Captura ${index + 1}`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <div class="lg:col-span-1">
        <div
          class="sticky top-24 space-y-6 bg-surface-container-lowest p-6 rounded-4xl border border-outline/10"
        >
          <div
            class="aspect-video bg-surface-variant group rounded-2xl overflow-hidden"
          >
            <img
              src={project.mainImage}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>

          <div class="bg-surface rounded-3xl p-6 border border-outline/20">
            <div class="space-y-3">
              {
                project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full px-6 py-3 bg-primary text-on-primary rounded-lg font-medium hover:scale-105 transition-all flex items-center justify-center gap-2"
                  >
                    <span class="text-xl">
                      <Icon name="redo-2" class="w-6 h-6" />
                    </span>
                    {t("project.nav.liveDemo")}
                  </a>
                )
              }
              {
                project.repo && (
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full px-6 py-3 border-2 border-secondary text-secondary rounded-lg font-medium hover:bg-secondary hover:text-on-primary transition-all flex items-center justify-center gap-2"
                  >
                    <span class="text-xl">
                      <Icon name="github" class="w-6 h-6" />
                    </span>
                    {t("project.nav.repository")}
                  </a>
                )
              }
            </div>
          </div>

          <div class="bg-tertiary-container rounded-3xl p-6">
            <h3 class="text-lg font-bold text-on-tertiary-container mb-4">
              {t("project.nav.projectInfo")}
            </h3>
            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-on-tertiary-container"
                  >{t("project.nav.duration")}</span
                >
                <span class="text-secondary-fixed font-medium"
                  >{project.timeline}</span
                >
              </div>
              <div class="flex justify-between items-center">
                <span class="text-on-tertiary-container"
                  >{t("project.nav.role")}</span
                >
                <span class="text-secondary-fixed font-medium"
                  >{project.role}</span
                >
              </div>
            </div>
          </div>

          <div class="bg-surface-container-high rounded-3xl p-6">
            <h3 class="text-lg font-bold text-primary mb-4">
              {t("project.nav.navigation")}
            </h3>
            <div
              class="space-y-2 [&>a]:flex [&>a]:w-full [&>a]:items-center [&>a]:gap-2 [&>a]:text-on-surface-variant [&>a]:hover:text-primary [&>a]:transition-colors"
            >
              <a href="#overview">
                <Icon name="notebook" class="w-6 h-6" />
                <span>{t("project.nav.overview")}</span>
              </a>
              <a href="#features">
                <Icon name="sparkles" class="w-6 h-6" />
                <span>{t("project.nav.features")}</span>
              </a>
              <a href="#challenges">
                <Icon name="trending-up-down" class="w-6 h-6" />
                <span>{t("project.nav.challenges")}</span>
              </a>

              <a href="#technologies">
                <Icon name="pickaxe" class="w-6 h-6" />
                <span>{t("project.nav.technologies")}</span>
              </a>
              {
                project.images.length > 0 && (
                  <a href="#gallery">
                    <Icon name="images" class="w-6 h-6" />
                    <span>{t("project.nav.gallery")}</span>
                  </a>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .prose {
    line-height: 1.75;
  }

  .prose p {
    margin-bottom: 1.25rem;
  }

  section[id] {
    scroll-margin-top: 100px;
  }
</style>

<script>
  document
    .querySelectorAll(".group.cursor-pointer")
    .forEach((imageContainer) => {
      imageContainer.addEventListener("click", function (this: HTMLElement) {
        const img = this.querySelector("img");
        if (img) {
          // Create modal
          const modal = document.createElement("div");
          modal.className =
            "fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50 p-4";
          modal.innerHTML = `
          <div class="relative max-w-4xl max-h-full bg-surface-container-low rounded-4xl p-2">
            <img src="${img.src}" alt="${img.alt}" class="max-w-full max-h-full object-contain rounded-lg">
          </div>
        `;

          document.body.appendChild(modal);

          modal.addEventListener("click", function (e) {
            if (
              e.target === modal ||
              (e.target && (e.target as Element).querySelector("button"))
            ) {
              document.body.removeChild(modal);
            }
          });

          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && modal.parentNode) {
              document.body.removeChild(modal);
            }
          });
        }
      });
    });
</script>
