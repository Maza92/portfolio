---
import ThemeSwitcher from "./ThemeSwitcher.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations } from "../i18n/utils";

const homeLink = `/${Astro.currentLocale}/`;
const aboutLink = `/${Astro.currentLocale}/about/`;
const projectsLink = `/${Astro.currentLocale}/projects/`;
const t = useTranslations(Astro.currentLocale as "en" | "es");
---

<nav
  class="bg-surface-container-low/80 backdrop-blur-md text-on-background px-8 py-6 flex justify-between items-center border-b border-b-surface-container-high top-0 z-50 sticky"
>
  <a class="font-bold text-2xl text-primary" href={homeLink}
    >{t("nav.home")}
  </a>

  <ul
    class="flex space-x-4 font-medium
    [&>li]:relative
    [&>li]:text-outline
    [&>li]:before:content-['']
    [&>li]:before:absolute
    [&>li]:before:-bottom-1
    [&>li]:before:right-0
    [&>li]:before:h-[2px]
    [&>li]:before:rounded-full
    [&>li]:before:w-0
    [&>li]:before:bg-primary
    [&>li]:before:transition-all
    [&>li]:before:duration-300
    [&>li:hover]:before:w-full
    [&>li:hover]:text-on-background
    [&>li:hover]:before:left-0
    [&>li:hover]:before:right-auto"
  >
    <li><a href={aboutLink}>{t("nav.about")}</a></li>
    <li><a href={projectsLink}>{t("nav.projects")}</a></li>
  </ul>
  <div class="flex items-center justify-center gap-2">
    <ThemeSwitcher />
    <LanguageSwitcher />
  </div>
</nav>
