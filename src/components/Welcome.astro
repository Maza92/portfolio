---
import user from "@assets/user.png";
import Card from "./Card.astro";
import SkillsCard from "./SkillsCard.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale as "en" | "es");

const projects = [
  {
    id: "auth-service",
    title: t("projects.authservice.title"),
    description: t("projects.authservice.description"),
    image: "/authservice-preview.png",
    technologies: ["Spring Boot 3", "JWT", "PostgreSQL"],
  },
  {
    id: "smart-serve-backend",
    title: t("projects.smartservebackend.title"),
    description: t("projects.smartservebackend.description"),
    image: "/smart-serve-backend-preview.png",
    technologies: ["Spring Boot 3", "PostgreSQL", "WebSocket", "JWT"],
  },
  {
    id: "smart-serve-frontend",
    title: t("projects.smartservefrontend.title"),
    description: t("projects.smartservefrontend.description"),
    image: "/smart-serve-preview.png",
    technologies: ["Angular 19", "TypeScript", "Tailwind CSS", "Capacitor"],
  },
];

const skills = [
  {
    title: t("skills.backend.title"),
    skills: [
      { name: "Spring Boot", icon: "spring", category: "primary" as const },
      { name: ".NET Core", icon: "dotnet", category: "primary" as const },
      { name: "NestJS", icon: "nestjs", category: "secondary" as const },
      { name: "Node.js", icon: "node", category: "primary" as const },
    ],
  },
  {
    title: t("skills.frontend.title"),
    skills: [
      { name: "Angular", icon: "angular", category: "secondary" as const },
      { name: "Astro", icon: "astro", category: "primary" as const },
      {
        name: "TypeScript",
        icon: "typescript",
        category: "secondary" as const,
      },
      { name: "JavaScript", icon: "javascript", category: "primary" as const },
    ],
  },
  {
    title: t("skills.tools.title"),
    skills: [
      { name: "Linux", icon: "linux", category: "secondary" as const },
      { name: "Git", icon: "git", category: "primary" as const },
      { name: "Docker", icon: "docker", category: "secondary" as const },
      { name: "PostgreSQL", icon: "postgresql", category: "primary" as const },
    ],
  },
  {
    title: t("skills.competencies.title"),
    skills: [
      {
        name: "Problem Solving",
        icon: "",
        category: "secondary" as const,
      },
      { name: "Team Work", icon: "", category: "primary" as const },
      { name: "Agile", icon: "", category: "secondary" as const },
      { name: "CI/CD", icon: "", category: "primary" as const },
    ],
  },
];
---

<section
  id="hero"
  class="flex items-center bg-surface-container-low justify-center min-h-dvh py-20 overflow-hidden hero-pattern"
>
  <div class="container mx-auto">
    <div class="flex items-center justify-center gap-12 flex-wrap">
      <div class="float">
        <div
          class="w-80 h-80 rounded-full bg-gradient-to-br from-primary to-secondary p-1"
        >
          <div
            class="w-full h-full rounded-full bg-background flex items-center justify-center overflow-hidden"
          >
            <div
              class="w-72 h-72 rounded-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center text-8xl font-bold text-primary"
            >
              <img
                src={user.src}
                alt="Luis Maza"
                class="w-full h-full rounded-full"
              />
            </div>
          </div>
        </div>
      </div>

      <div
        class="flex flex-col space-y-6 min-w-[300px] max-w-[500px] fade-in-up px-8 text-center sm:text-left"
      >
        <h1 class="text-7xl font-bold gradient-bg">{t("hero.title")}</h1>
        <p class="text-outline text-xl">{t("hero.subtitle")}</p>
        <p class="text-lg leading-relaxed">{t("hero.description")}</p>
        <div class="flex flex-col sm:flex-row gap-4 mt-6">
          <button class="button button-primary">{t("hero.viewProjects")}</button
          >
          <a href="#contact" class="button button-outline"
            >{t("hero.contact")}</a
          >
          <a
            href="/cv.pdf"
            download="Luis_Maza_CV.pdf"
            class="button button-outline">CV</a
          >
        </div>
      </div>
    </div>
  </div>
</section>

<section id="projects" class="py-20 bg-surface">
  <div class="container mx-auto px-8">
    <h2 class="text-4xl font-bold text-center mb-16 gradient-bg">
      {t("projects.title")}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((project) => (
          <Card
            title={project.title}
            description={project.description}
            image={project.image}
            technologies={project.technologies}
            link={`/${Astro.currentLocale}/project/${project.id}`}
          />
        ))
      }
    </div>

    <div class="text-center mt-12">
      <button class="button button-primary-disabled">
        {t("projects.viewAll")}
      </button>
    </div>
  </div>
</section>

<section id="skills" class="py-20 bg-background">
  <div class="container mx-auto px-8">
    <h2 class="text-4xl font-bold text-center mb-16 gradient-bg">
      {t("skills.title")}
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {
        skills.map((skillGroup) => (
          <SkillsCard title={skillGroup.title} skills={skillGroup.skills} />
        ))
      }
    </div>
  </div>
</section>

<section id="contact" class="py-20 bg-surface">
  <div class="container mx-auto px-8 text-center">
    <h2 class="text-4xl font-bold mb-8 gradient-bg">{t("contact.title")}</h2>
    <p class="text-xl text-outline mb-8 max-w-2xl mx-auto">
      {t("contact.description")}
    </p>
    <div class="flex justify-center gap-6">
      <a href="mailto:maza05599@gmail.com" class="button button-primary">
        {t("contact.email")}
      </a>
      <a href="#" class="button button-outline">
        {t("contact.linkedin")}
      </a>
    </div>
  </div>
</section>

<style is:global>
  [data-theme="dark"] .hero-pattern {
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(255, 255, 255, 0.08) 1px,
      transparent 0
    );
    background-size: 50px 50px;
  }

  .hero-pattern {
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(0, 0, 0, 0.28) 1px,
      transparent 0
    );
    background-size: 50px 50px;
  }
</style>
