---
import { Image } from "astro:assets";

export interface Props {
  title: string;
  description: string;
  image: string;
  technologies: string[];
  link?: string;
}

const { title, description, image, technologies, link } = Astro.props;
---

<div
  class="bg-surface-container-low rounded-4xl p-6 card-hover border border-surface-container-high flex flex-col h-full transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-on-surface/20"
>
  <div class={`h-48 b rounded-lg mb-4 flex items-center justify-center`}>
    <Image
      src={image}
      alt={title}
      width={48}
      height={48}
      class="w-full h-full rounded-2xl"
    />
  </div>

  <h3 class="text-xl font-bold mb-2 text-primary">
    {title}
  </h3>

  <p class="text-outline mb-4">{description}</p>

  <div class="flex flex-wrap gap-2 mb-4">
    {
      technologies.map((tech, index) => (
        <span
          class={`px-3 py-1 rounded-full text-sm ${
            index % 2 === 0
              ? "bg-primary/20 text-primary"
              : "bg-secondary/20 text-secondary"
          }`}
        >
          {tech}
        </span>
      ))
    }
  </div>

  <div class="mt-auto">
    {
      link ? (
        <a
          href={link}
          rel="noopener noreferrer"
          class="block w-full py-2 border border-transparent text-primary rounded-lg hover:bg-primary hover:text-on-primary transition-all text-center"
        >
          Ver Detalles
        </a>
      ) : (
        <button class="w-full py-2 border border-primary text-primary rounded-lg hover:bg-primary hover:text-on-primary transition-all">
          Ver Detalles
        </button>
      )
    }
  </div>
</div>
